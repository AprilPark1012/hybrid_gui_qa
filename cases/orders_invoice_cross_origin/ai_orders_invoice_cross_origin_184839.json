{
  "case_id": "ai_orders_invoice_cross_origin_184839",
  "name": "【跨 origin 演练 · 三个业务系统 + 一套 SSO】\n先登录（SSO，只在 8000 上登录一次），然后在订单系统(8001)里按订单名称搜索到一条订单，\n再切到发票系统(8002)确认发票列表能打开。",
  "base_url": "http://localhost:8000/",
  "steps": [
    {
      "op": "goto",
      "desc": "打开 【合同列表页】http://localhost:8000/",
      "url": "http://localhost:8000/"
    },
    {
      "op": "goto",
      "desc": "从合同系统(8000)切到订单系统(8001)，复用同一套 SSO 登录态、免再次登录",
      "url": "http://localhost:8001/orders.html"
    },
    {
      "op": "fill",
      "desc": "在订单系统顶部筛选区按订单名称填入搜索关键词",
      "element": "订单名称@订单列表页",
      "value": "北京华信2月设备升级订单"
    },
    {
      "op": "click",
      "desc": "点击搜索按钮，按订单名称过滤订单列表",
      "element": "搜索@订单列表页"
    },
    {
      "op": "goto",
      "desc": "从订单系统(8001)切到发票系统(8002)，继续复用 SSO 登录态",
      "url": "http://localhost:8002/invoice_list.html"
    }
  ],
  "asserts": [
    {
      "desc": "确认 SSO 登录后落在合同系统首页（登录由框架前置完成，这里只验登录态与落点）",
      "expect": "合同管理系统",
      "after_step": 1
    },
    {
      "kind": "url",
      "desc": "到达证据：订单列表页 URL 独有片段 orders.html（仅该页含）",
      "expect": "orders.html",
      "after_step": 2
    },
    {
      "desc": "到达证据：订单系统页面特征文案出现，证明 SSO 免登录直达成功",
      "expect": "订单系统",
      "after_step": 2
    },
    {
      "kind": "first_row",
      "row_field": "orderName",
      "desc": "验证按订单名称搜到了该订单：订单列表页首行的订单名称列即该订单",
      "expect": "北京华信2月设备升级订单",
      "after_step": 4
    },
    {
      "kind": "url",
      "desc": "到达证据：发票列表页 URL 独有片段 invoice_list.html（仅该页含）",
      "expect": "invoice_list.html",
      "after_step": 5
    },
    {
      "desc": "确认发票列表能打开：应收发票列表页面特征标题文案出现",
      "expect": "应收发票列表",
      "after_step": 5
    }
  ],
