{
  "case_id": "hand_enter_search",
  "name": "手搓用例 · 回车触发搜索 + 客户右模糊筛选",
  "base_url": "http://localhost:8000",
  "steps": [
    {
      "op": "goto",
      "desc": "打开合同列表页",
      "url": "http://localhost:8000"
    },
    {
      "op": "fill",
      "desc": "在搜索框输入'合同7'",
      "element": "合同编号_名称_管理单元_合同类型_帐套",
      "value": "合同7"
    },
    {
      "op": "press_enter",
      "desc": "在搜索框按回车触发查询",
      "element": "合同编号_名称_管理单元_合同类型_帐套"
    },
    {
      "op": "fill",
      "desc": "客户筛选框输入前缀『北京』（右模糊：c1/c5 两家）",
      "element": "客户名称_右模糊_前缀匹配",
      "value": "北京"
    },
    {
      "op": "click",
      "desc": "点击搜索按钮",
      "element": "搜索"
    }
  ],
  "asserts": [
    {
      "kind": "count",
      "selector": "#tbody-contracts tr[data-testid^='row-']",
      "expect": 1,
      "desc": "关键字『合同7』(HT-1007) × 客户前缀『北京』(北京华信) ⇒ 1 条"
    },
    {
      "desc": "断言列表状态行出现搜索完成前缀",
      "expect": "搜索完成"
    }
  ]
}
