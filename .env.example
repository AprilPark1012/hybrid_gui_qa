# ============================================================
# Browser Use 探索阶段需要用 LLM（这是 AI 之力的成本来源）
# 挑这些 provider 的任意一个填 key 即可（Browser Use 支持多 provider）
# ============================================================
# 推荐：Browser Use 自家的 ChatBrowserUse（针对浏览器自动化优化的模型，最快最省）
# BROWSER_USE_API_KEY=bu_xxx     # 去 https://cloud.browser-use.com/new-api-key 申请，新人送 $15

# 或者用通用 provider（四选一，配置了哪个用哪个）：
# OPENAI_API_KEY=sk-xxx
# GOOGLE_API_KEY=xxx
# ANTHROPIC_API_KEY=sk-ant-xxx

# ★ 推荐：DeepSeek（OpenAI 兼容，国内直连快、便宜）—— 跑「AI 语义识别」链路首选
# key 从这里申请：https://platform.deepseek.com   （登录 → API Keys → 创建）
# 注意：config.py 用 browser-use 0.13.10 原生 ChatDeepSeek，base_url 需带 /v1
DEEPSEEK_API_KEY=sk-你的deepseek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# Playwright 执行阶段不需要 LLM —— 确定性执行，零 token 成本
# ============================================================

# 被测应用地址（demo 默认起在本地 8000）
TARGET_URL=http://localhost:8000
